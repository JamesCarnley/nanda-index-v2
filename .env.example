# NANDA Index — environment variables
# Copy to .env and fill in values before running docker compose up

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=nanda-local

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── OAuth (optional — create apps at console.cloud.google.com / github.com/settings/developers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=http://localhost:3001

# ── Email (log = print verification link to console; no real email sent)
SMTP_URL=log
EMAIL_FROM=noreply@nanda.local

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
# Public API URL used by the Next.js frontend at build time
NEXT_PUBLIC_NANDA_INDEX_API_URL=http://localhost:3001

# Optional, read-only ERC-8004 City 0.1 follower. Omit/leave blank to disable.
# Replace registry and genesisHash with values from the actual chosen local chain.
# confirmations=0 is provisional local-demo mode, not chain finality.
# ERC8004_IDENTITY_CONFIG={"rpcUrl":"http://127.0.0.1:8545","chainId":31337,"registry":"0x1111111111111111111111111111111111111111","genesisHash":"0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","startBlock":"1","adapter":"nandacity-0.1","confirmations":0,"pollMs":2000,"maxBlockSpan":200}

# ── Misc ──────────────────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
# Optional numeric IP bind address for direct server runs; unset defaults to 0.0.0.0.
# Use loopback for a local-only demo, not for a server behind Docker-published ports.
# BIND_HOST=127.0.0.1

# ── Signing (optional — only for signed IndexRecord responses)
SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=
