{
  "name": "nanda-index",
  "version": "0.1.0",
  "description": "NANDA Index — authoritative registry of agent registries",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "demo:seed": "DEMO_MODE=true tsx --env-file=.env scripts/seed-demo.ts",
    "demo:run": "DEMO_MODE=true tsx --env-file=.env scripts/demo-flow.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.1",
    "openai": "^6.48.0",
    "postgres": "^3.4.4",
    "resend": "^6.12.4",
    "viem": "2.56.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "24.13.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vitest": {
      "vite": "^6.4.3"
    }
  }
}
